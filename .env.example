# Environment Configuration Example for GateSentry
PROJECT_NAME="GateSentry"
ENVIRONMENT="development"
SECRET_KEY="replace-with-a-random-local-development-key"
POSTGRES_PASSWORD="replace-with-a-local-postgres-password"
APP_DB_PASSWORD="replace-with-a-random-application-database-password"
WORKER_DB_PASSWORD="replace-with-a-random-worker-database-password"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL default in docker / SQLite local fallback)
DATABASE_URL="postgresql+psycopg://gatesentry_app:replace-me@localhost:5432/gatesentry_db"
# Local fallback:
# DATABASE_URL="sqlite:///./gatesentry.db"

# Qdrant Vector Database
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION="incident_embeddings"
QDRANT_USE_EMBEDDED="false"

# Detector Ingestion API Key (External YOLOv8 + ByteTrack pipeline)
DETECTOR_API_KEY="replace-with-a-random-local-ingestion-key"

# Demo Mode & Defaults
DEFAULT_GATE_SESSION_WINDOW_SECONDS=8
DEFAULT_MIN_DETECTION_CONFIDENCE=0.65
DEFAULT_ZONE_SENSITIVITY_BONUS=15

# Frontend Public Variables
NEXT_PUBLIC_API_URL="http://localhost:8000"
