# Copy this file to backend/.env and fill in your own values.
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=gatesentry

# Superuser - used ONLY by scripts/init_db.py (creates database, roles, schema)
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=your_postgres_password

# Runtime application role (created by init_db.py)
PG_APP_USER=gatesentry_app
PG_APP_PASSWORD=GsApp@2026

# Demo login accounts (created as PostgreSQL login roles by init_db.py)
DEMO_ADMIN_USER=admin
DEMO_ADMIN_PASSWORD=Admin@123
DEMO_SECURITY_USER=guard
DEMO_SECURITY_PASSWORD=Guard@123

# MongoDB - local server by default; for Atlas use mongodb+srv://<user>:<pass>@<cluster>/
MONGO_URI=mongodb://localhost:27017
MONGO_DB=gatesentry

JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE_MINUTES=480
FRONTEND_ORIGIN=http://localhost:3000
